{
  "name": "bc-room-map-editor",
  "version": "1.0.0",
  "description": "BC (Bondage Club) room-map string generator + visual editor. Build mappaste-compatible maps with a 40x40 grid, layers, i18n UI, and zero mods.",
  "private": true,
  "scripts": {
    "build": "node scripts/build-editor.js",
    "test": "node tests/test-editor.js && node tests/test-sync.js",
    "example": "node examples/example.js",
    "sync": "node scripts/sync-upstream.js",
    "sync:force": "node scripts/sync-upstream.js --force",
    "sync:check": "node scripts/sync-upstream.js --check-only"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "opencc-js": "^1.4.2"
  }
}
